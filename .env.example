# Claves del proyecto de Firebase para sincronizar los datos entre
# dispositivos. Sin esto la app funciona igual, pero cada celular guarda
# sus datos por separado.
#
# Como conseguirlas: ver "Sincronizar entre dispositivos" en el README.
#
# 1. Copiar este archivo a ".env" (o cargar las mismas claves como
#    "variables de entorno" / "secrets" en GitHub, si se publica con
#    GitHub Actions).
# 2. Volver a compilar la app (npm run build) para que tomen efecto.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
