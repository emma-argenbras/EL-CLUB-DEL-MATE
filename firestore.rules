rules_version = '2';

// Reglas de seguridad de Firestore para El Club del Mate.
//
// Como pegarlas: Firebase Console > Firestore Database > Reglas >
// pegar este contenido entero > Publicar.
//
// Roles: cada persona se loguea con su propio mail. "owner" ve y maneja
// todo el negocio. "empleado" opera el dia a dia pero no ve numeros de
// ganancia ni puede archivar productos sin autorizacion de un owner.
//
// Fundadores: los unicos mails que pueden auto-asignarse el rol "owner"
// la primera vez que se loguean (arranque de la cuenta, sin depender de
// que ya exista otro owner). Despues de ese primer login, cualquier owner
// puede crear o promover otros usuarios desde la app (Ajustes > Usuarios
// del equipo), sin volver a tocar este archivo nunca mas.
//
// Desactivar a alguien: un owner puede apagarle el acceso a cualquiera
// desde Ajustes (incluso a otro owner). Mientras este desactivado, sus
// lecturas se mantienen (asi la app le puede seguir mostrando la pantalla
// de "acceso desactivado"), pero no puede escribir nada en el negocio.
service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function esFundador() {
      return estaLogueado() && request.auth.token.email in [
        'emmanuel@elclubdelmate.com',
        'sebastian@elclubdelmate.com'
      ];
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/negocios/el-club-del-mate/usuarios/$(request.auth.uid)).data;
    }

    function tengoPerfil() {
      return estaLogueado() &&
        exists(/databases/$(database)/documents/negocios/el-club-del-mate/usuarios/$(request.auth.uid));
    }

    function estoyActivo() {
      return tengoPerfil() && miPerfil().activo != false;
    }

    function soyOwner() {
      return estoyActivo() && miPerfil().rol == 'owner';
    }

    function soyEncargado() {
      return estoyActivo() && miPerfil().rol == 'encargado';
    }

    // Al mando del negocio: un dueño o un encargado. Casi todo lo que
    // antes era "solo un owner" es en realidad esto. Lo que queda
    // reservado al dueño son las tres cosas que pueden destruir o
    // repartir el negocio entero: borrar los datos, pisarlos con un
    // respaldo, y decidir quien mas es dueño.
    function estoyAlMando() {
      return soyOwner() || soyEncargado();
    }

    // Perfiles de usuario: quien es cada quien y que rol tiene. Un
    // fundador puede crear SU PROPIO perfil como owner (arranque de la
    // cuenta); despues de eso, solo un owner ya existente puede crear,
    // editar, desactivar o borrar perfiles (para sumar a Gabriela, o para
    // cortarle el acceso a alguien). La lectura queda abierta a cualquiera
    // logueado (incluso desactivado) para que la app pueda mostrarle por
    // que se quedo afuera.
    // Un encargado puede dar de alta y manejar al equipo, pero no a los
    // dueños: ni los crea, ni los edita, ni les apaga el acceso, ni se
    // asciende a si mismo. Si pudiera cualquiera de esas cosas, el
    // limite de su propio rol seria una formalidad.
    //
    // Se mira el rol de los DOS lados: el que tiene el documento ahora y
    // el que tendria despues. Mirar solo uno dejaria pasar la mitad
    // (ascender a alguien, o degradar a un dueño para despues tocarlo).
    function elObjetivoNoEsDueno() {
      return resource == null || resource.data.get('rol', '') != 'owner';
    }

    function noQuedaComoDueno() {
      return request.resource == null || request.resource.data.get('rol', '') != 'owner';
    }

    match /negocios/el-club-del-mate/usuarios/{uid} {
      allow read: if estaLogueado();
      allow create: if estaLogueado() && (
        (request.auth.uid == uid && esFundador() && request.resource.data.rol == 'owner') ||
        soyOwner() ||
        (soyEncargado() && noQuedaComoDueno())
      );
      allow update: if soyOwner() ||
        (soyEncargado() && elObjetivoNoEsDueno() && noQuedaComoDueno());
      allow delete: if soyOwner() || (soyEncargado() && elObjetivoNoEsDueno());
    }

    // El historial de modificaciones: es un registro, no se edita ni se
    // borra, solo se agregan renglones nuevos, y siempre a nombre de
    // quien esta logueado (no se puede firmar un cambio en nombre de
    // otra persona).
    //
    // update y delete son 'false' para TODOS, incluido un dueño. No es
    // un olvido: un historial que alguien puede retocar no sirve como
    // historial, y el unico que tendria motivo para retocarlo es quien
    // tiene algo que esconder.
    match /negocios/el-club-del-mate/historial/{entradaId} {
      allow read: if estaLogueado();
      allow create: if estoyActivo() && request.resource.data.quien == request.auth.token.email;
      allow update, delete: if false;
    }

    // La tabla vieja, solo de productos. Queda cerrada igual: todavia
    // hay renglones ahi de antes de la migracion.
    match /negocios/el-club-del-mate/historialProductos/{entradaId} {
      allow read: if estaLogueado();
      allow create: if estoyActivo() && request.resource.data.quien == request.auth.token.email;
      allow update, delete: if false;
    }

    // Productos: cualquiera activo puede crear y editar (cargar costos,
    // stock, etc.), pero cambiar el precio de venta o archivar un producto
    // queda reservado a un owner. Nunca se borran de verdad: la unica
    // forma de sacar un producto de circulacion es archivarlo. La lectura
    // queda abierta a cualquiera logueado (aunque este desactivado, para
    // no cortar la primera sincronizacion de un fundador recien creado,
    // que todavia no tiene perfil propio en el instante en que arranca).
    // Un dato cargado no se pisa con vacio.
    //
    // El 20/10/2026 un celular al que le habian borrado los datos
    // volvio a entrar, se rearmo desde el catalogo publico --que no
    // lleva costos ni proveedores-- y subio esos productos vacios
    // encima de los del servidor. Quedaron ~280 productos sin
    // proveedor y 120 sin costo, sin un solo renglon en el historial.
    //
    // La app ya no lo intenta (ver sembrarCatalogo), pero esto es lo
    // que lo hace imposible: protege aunque el dispositivo tenga una
    // version vieja, que es justo el caso que no se puede controlar.
    //
    // La contra, dicha de frente: borrar a proposito un costo que esta
    // cargado tampoco se va a poder. Es raro, y es un precio barato
    // por no volver a perder 280 proveedores sin enterarse.
    function noPisaConVacio(campo) {
      return !(
        resource.data.get(campo, null) != null &&
        request.resource.data.get(campo, null) == null
      );
    }

    match /negocios/el-club-del-mate/productos/{codigo} {
      allow read: if estaLogueado();
      allow create: if estoyActivo();
      allow update: if estoyActivo() && (
        estoyAlMando() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archivado', 'precioVenta'])
      ) &&
        noPisaConVacio('precioCompra') &&
        noPisaConVacio('proveedorId') &&
        noPisaConVacio('proveedor') &&
        noPisaConVacio('rentabilidad');
      // Borrar un producto lo hace solo "Cambiar el codigo" (editar el
      // producto -> cambiarle el codigo), que antes mueve sus ventas y
      // sus compras al codigo nuevo y lo deja archivado. Con "if false"
      // el servidor rechazaba ese borrado y el codigo viejo quedaba vivo
      // en los otros celulares, con el producto repartido en dos. Lo
      // puede hacer quien puede cambiar codigos: dueño y encargada.
      allow delete: if estoyAlMando();
    }

    // El dia de hoy en hora de Argentina. request.time viene en UTC y
    // Concordia esta en UTC-3 todo el año (el pais no cambia de hora
    // desde 2009), asi que alcanza con restar tres horas. Se arma como
    // texto 'aaaa-mm-dd' porque asi se guarda la fecha de la jornada.
    function dosDigitos(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function fechaDeHoy() {
      return string((request.time - duration.value(3, 'h')).year()) + '-' +
             dosDigitos((request.time - duration.value(3, 'h')).month()) + '-' +
             dosDigitos((request.time - duration.value(3, 'h')).day());
    }

    // Jornadas (los turnos de caja): cualquiera activo abre, carga y
    // cierra su turno, con dos cosas reservadas al dueño.
    //
    // 1) El visto bueno sobre una diferencia de caja. Si un empleado
    //    pudiera firmarlo, el control no controlaria nada: quien tuvo la
    //    diferencia se la aprobaria sola.
    //
    // 2) Cerrar un turno de un dia que no es hoy. Un turno que quedo sin
    //    cerrar y se cierra dias despues es una correccion sobre el
    //    pasado, y el dueño quiere enterarse en el momento. El empleado
    //    deja el pedido (solicitudCierre) con su conteo y el dueño lo
    //    autoriza desde su celular.
    //
    // Ojo con el alcance de (2): esto cubre los dias distintos de hoy,
    // que es lo que se puede calcular aca con certeza. El caso de cerrar
    // el turno de la mañana cuando el de la tarde ya arranco --mismo
    // dia-- lo maneja la app, no esta regla.
    match /negocios/el-club-del-mate/jornadas/{jornadaId} {
      allow read: if estaLogueado();
      // get('cierreAutorizado', null) y no .cierreAutorizado: en las reglas
      // de Firestore, leer un campo que NO EXISTE es un error de
      // evaluacion, y un error deniega. La app crea la jornada sin ese
      // campo, asi que la version directa rechazaba cada turno que se
      // abria --y el rechazo, al revertirse, llegaba al dispositivo como
      // un borrado: la caja se cargaba y desaparecia.
      allow create: if estoyActivo() &&
        request.resource.data.get('cierreAutorizado', null) == null;
      allow update: if estoyActivo() && (
        estoyAlMando() || (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cierreAutorizado']) &&
          !(
            request.resource.data.get('estado', '') == 'cerrado' &&
            resource.data.get('estado', '') != 'cerrado' &&
            resource.data.get('fecha', '') != fechaDeHoy()
          )
        )
      );
      allow delete: if estoyActivo();
    }

    // Todo lo demas del negocio (caja, ventas, gastos, proveedores): la
    // lectura alcanza con estar logueado (mismo motivo que en productos),
    // pero escribir requiere estar activo. La separacion de que ve cada
    // rol en pantalla (por ejemplo, ocultar Reportes a un empleado) se
    // maneja en la app, no aca.
    match /negocios/el-club-del-mate/{coleccion}/{documento} {
      allow read: if estaLogueado() &&
        coleccion != 'usuarios' &&
        coleccion != 'historial' &&
        coleccion != 'historialProductos' &&
        coleccion != 'productos' &&
        coleccion != 'jornadas';
      allow write: if estoyActivo() &&
        coleccion != 'usuarios' &&
        coleccion != 'historial' &&
        coleccion != 'historialProductos' &&
        coleccion != 'productos' &&
        coleccion != 'jornadas';
    }
  }
}
